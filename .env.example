# Copy this file to .env and fill in ONE provider's key. Never commit your
# real .env -- it's gitignored on purpose. Without any key configured, the
# app runs in MOCK mode (placeholder LLM output, real search APIs still run).

# Which provider to use: deepseek | openai | anthropic
LLM_PROVIDER=deepseek

# --- DeepSeek (https://platform.deepseek.com) ---
# Cheapest option here; OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic / Claude (https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Optional: Semantic Scholar (https://www.semanticscholar.org/product/api#api-key-form) ---
# Without a key, Semantic Scholar's public rate limit is very low and will
# frequently 429 under normal use. A free key raises that limit substantially.
SEMANTIC_SCHOLAR_API_KEY=
