# Web: keys in this file are NEVER used for visitor model calls. Each visitor
# supplies their own key in the sidebar. These credentials are local CLI/eval only.
# Copy this file to .env and fill in ONE provider's key. Never commit your
# real .env -- it's gitignored on purpose. Missing credentials do not silently
# enable demo mode; set MOCK_MODE=1 explicitly for offline synthetic fixtures.

# Which provider to use: deepseek | openai | anthropic
LLM_PROVIDER=deepseek

# --- DeepSeek (https://platform.deepseek.com) ---
# OpenAI-compatible API, handled by the DeepSeek adapter.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic / Claude (https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Optional: Semantic Scholar (https://www.semanticscholar.org/product/api#api-key-form) ---
# Without a key, Semantic Scholar's public rate limit is very low and will
# frequently 429 under normal use. A free key raises that limit substantially.
SEMANTIC_SCHOLAR_API_KEY=

# Force offline synthetic demo even if a real key exists (0/1).
MOCK_MODE=0
# Local embedding weights only by default; opt in to downloading separately.
ALLOW_EMBEDDING_DOWNLOAD=0
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Engineering starting limits; not experimentally optimized.
RESEARCH_MAX_PAPERS=10
RESEARCH_MIN_PAPERS=5
RESEARCH_MAX_FULLTEXTS=10
RESEARCH_MAX_SEARCH_ROUNDS=2
RESEARCH_MAX_REVIEW_ROUNDS=3
RESEARCH_MAX_CLAIM_REVISIONS=1
RESEARCH_MAX_REQUESTS=80
RESEARCH_MAX_MODEL_CALLS=30
RESEARCH_MAX_OUTPUT_TOKENS=4096
RESEARCH_MAX_TOTAL_TOKENS=100000
RESEARCH_CONTEXT_TOKENS=12000
RESEARCH_TIMEOUT=20
RESEARCH_MAX_DOWNLOAD_MB=20
RESEARCH_MAX_PAGES=100
RESEARCH_CHUNK_TOKENS=500
RESEARCH_CHUNK_OVERLAP=75
RESEARCH_RETRIEVAL_MODE=hybrid
RESEARCH_RERANK=0
RESEARCH_CHECK_CLAIMS=1
RESEARCH_FULLTEXT=1
# Real evaluation is disabled unless explicitly opted in WITH a local budget.
ALLOW_PAID_EVAL=0
